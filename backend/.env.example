# Environment: development | production | test
ENVIRONMENT=development

# Backend server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Security & Authentication
# Generate a secure secret in production (e.g., openssl rand -hex 32)
JWT_SECRET=foodverse-ai-insecure-dev-secret-change-in-production-12345
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Local SQLite for development; use PostgreSQL for production:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/foodverse
DATABASE_URL=sqlite:///./foodverse.db

# CORS: comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Uploads Configuration
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp,mp4,mov,avi

# AI Provider Configuration: 'gemini' | 'openai' | 'none'
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional OpenAI fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional offline demo heuristic mode if no provider key is available: true | false
ENABLE_OFFLINE_DEMO_FALLBACK=false
